---
import { site } from '../site'
---

<section class='profile' aria-labelledby='profile-title'>
  <img src='/avatar.jpg' alt={`${site.name} 的头像`} width='112' height='112' />
  <p class='eyebrow'>学习 / 实践 / 记录</p>
  <h1 id='profile-title'>你好，我是 {site.name}。</h1>
  <p class='intro'>{site.description}</p>
</section>

<style>
  .profile { padding-block: 64px 56px; }
  img { display: block; border-radius: 50%; border: 1px solid var(--border); }
  .eyebrow { margin: 28px 0 12px; color: var(--accent); font-size: 13px; letter-spacing: .12em; }
  h1 { margin: 0; font-size: clamp(28px, 5vw, 40px); line-height: 1.35; letter-spacing: -.03em; }
  .intro { color: var(--muted); line-height: 1.8; margin: 16px 0 0; }
  @media (max-width: 600px) { .profile { padding-block: 40px; } }
</style>
