---
// The home page's first screen: avatar, name and a terminal that types the intro.
// It sits inside the banner, which is full height on the home page.
import { HERO_PROMPT, HERO_TERMINAL } from "@constants/hero";
import { Icon } from "astro-icon/components";
import { profileConfig } from "../config";
import { MAIN_PANEL_OVERLAPS_BANNER_HEIGHT } from "../constants/constants";
import { url } from "../utils/url-utils";
import ImageWrapper from "./misc/ImageWrapper.astro";
import "@fontsource-variable/jetbrains-mono";
---
<div id="home-hero" style={`--hero-bottom: ${MAIN_PANEL_OVERLAPS_BANNER_HEIGHT}rem`}>
    <div class="hero-inner">
        <a href={url("/about/")} class="hero-avatar" aria-label="关于我">
            <ImageWrapper src={profileConfig.avatar || ""} alt={profileConfig.name} class="w-full h-full" />
        </a>
        <div class="hero-name">{profileConfig.name}</div>

        <div class="hero-term" role="img" aria-label={HERO_TERMINAL.map((s) => `${s.command}: ${s.output}`).join("；")}>
            <div class="term-bar"><span></span><span></span><span></span><em>~/blog</em></div>
            <div class="term-body" aria-hidden="true">
                {HERO_TERMINAL.map((step) => (
                    <div class="term-step">
                        <div><span class="term-prompt">{HERO_PROMPT}</span> <span class="term-cmd" data-text={step.command}>{step.command}</span></div>
                        <div class="term-out">{step.output}</div>
                    </div>
                ))}
                <div class="term-step term-last"><span class="term-prompt">{HERO_PROMPT}</span> <span class="term-caret"></span></div>
            </div>
        </div>
    </div>

    <a href="#main-grid" class="hero-down" aria-label="往下看近期活动">
        <span>近期活动</span>
        <Icon name="material-symbols:keyboard-arrow-down-rounded" class="text-2xl"></Icon>
    </a>
</div>

<style is:global>
    #home-hero {
        position: absolute;
        inset: 0 0 var(--hero-bottom) 0;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 4.5rem 1rem 2.5rem;
        transition: opacity 0.5s ease, visibility 0.5s;
    }
    /* Darken the photo a little so the text stays readable */
    #home-hero::before {
        content: "";
        position: absolute;
        inset: 0 0 calc(-1 * var(--hero-bottom)) 0;
        background: radial-gradient(ellipse at 50% 45%, rgb(3 4 10 / 0.25), rgb(3 4 10 / 0.6));
        pointer-events: none;
    }
    /* The banner stays mounted across page transitions, so the hero only shows on home */
    body:not(.is-home) #home-hero { opacity: 0; visibility: hidden; }

    #home-hero .hero-inner {
        position: relative;
        width: min(36rem, 100%);
        display: flex;
        flex-direction: column;
        align-items: center;
    }
    #home-hero .hero-avatar {
        display: block;
        width: 6.5rem;
        height: 6.5rem;
        border-radius: 9999px;
        overflow: hidden;
        border: 2px solid rgb(200 215 255 / 0.55);
        box-shadow: 0 0 0 8px rgb(150 170 255 / 0.1);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    #home-hero .hero-avatar:hover { transform: scale(1.04); box-shadow: 0 0 0 10px rgb(150 170 255 / 0.16); }
    #home-hero .hero-name {
        margin: 0.875rem 0 1.25rem;
        color: white;
        font-size: 1.75rem;
        font-weight: 700;
        text-shadow: 0 2px 12px rgb(0 0 0 / 0.5);
    }

    #home-hero .hero-term {
        width: 100%;
        border-radius: 0.75rem;
        overflow: hidden;
        background: rgb(8 10 20 / 0.62);
        border: 1px solid rgb(255 255 255 / 0.1);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        box-shadow: 0 20px 50px rgb(0 0 0 / 0.35);
        font-family: "JetBrains Mono Variable", ui-monospace, monospace;
        font-size: 0.875rem;
        line-height: 1.7;
        text-align: left;
    }
    #home-hero .term-bar {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.55rem 0.8rem;
        background: rgb(255 255 255 / 0.05);
        border-bottom: 1px solid rgb(255 255 255 / 0.06);
    }
    #home-hero .term-bar span { width: 0.65rem; height: 0.65rem; border-radius: 9999px; background: rgb(255 255 255 / 0.18); }
    #home-hero .term-bar em { margin-left: auto; font-style: normal; font-size: 0.75rem; color: rgb(255 255 255 / 0.4); }
    #home-hero .term-body { padding: 0.9rem 1.1rem 1rem; min-height: 9.5rem; }
    #home-hero .term-step + .term-step { margin-top: 0.35rem; }
    #home-hero .term-prompt { color: oklch(0.78 0.12 var(--hue)); }
    #home-hero .term-cmd { color: rgb(255 255 255 / 0.92); }
    #home-hero .term-out { color: rgb(255 255 255 / 0.68); }
    #home-hero .term-caret {
        display: inline-block;
        width: 0.55em;
        height: 1.1em;
        vertical-align: -0.2em;
        background: rgb(255 255 255 / 0.75);
        animation: term-caret 1.1s ease-in-out infinite;
    }
    @keyframes term-caret { 0%, 100% { opacity: 1; } 50% { opacity: 0.15; } }

    /* While typing, steps not reached yet are hidden; outputs fade in once their command is typed */
    #home-hero.typing .term-step:not(.shown) { display: none; }
    #home-hero.typing .term-step.shown .term-out { opacity: 0; transform: translateY(4px); }
    #home-hero .term-out { transition: opacity 0.35s ease-out, transform 0.35s ease-out; }
    #home-hero .term-step.done .term-out { opacity: 1 !important; transform: none !important; }

    #home-hero .hero-down {
        position: absolute;
        left: 50%;
        bottom: 0.5rem;
        transform: translateX(-50%);
        display: flex;
        flex-direction: column;
        align-items: center;
        color: rgb(255 255 255 / 0.6);
        font-size: 0.75rem;
        letter-spacing: 0.2em;
        transition: color 0.2s ease, opacity 0.6s ease;
    }
    #home-hero .hero-down:hover { color: white; }
    #home-hero .hero-down svg { animation: hero-bob 2.4s ease-in-out infinite; }
    @keyframes hero-bob { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(4px); } }
    #home-hero.typing .hero-down { opacity: 0; }

    @media (max-width: 767px) {
        #home-hero .hero-avatar { width: 5.5rem; height: 5.5rem; }
        #home-hero .hero-name { font-size: 1.5rem; margin-bottom: 1rem; }
        #home-hero .hero-term { font-size: 0.8125rem; }
    }
    @media (prefers-reduced-motion: reduce) {
        #home-hero .term-caret, #home-hero .hero-down svg { animation: none; }
    }
</style>

<script>
// Types each command character by character, then fades in its output.
// Plays on every fresh visit, right after the splash; reduced motion shows the finished terminal.
const hero = document.getElementById("home-hero");

if (hero && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const steps = Array.from(hero.querySelectorAll<HTMLElement>(".term-step"));
    hero.classList.add("typing");
    for (const step of steps) {
        const cmd = step.querySelector<HTMLElement>(".term-cmd");
        if (cmd) cmd.textContent = "";
    }

    const wait = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));
    // Slightly uneven keystrokes read as a person typing rather than a metronome.
    const keystroke = () => 45 + Math.random() * 55;

    async function play() {
        for (const step of steps) {
            step.classList.add("shown");
            const cmd = step.querySelector<HTMLElement>(".term-cmd");
            if (cmd) {
                await wait(350);
                for (const ch of cmd.dataset.text ?? "") {
                    cmd.textContent += ch;
                    await wait(keystroke());
                }
                await wait(180);
            }
            step.classList.add("done");
        }
        hero?.classList.remove("typing");
    }

    // Start once the splash (if any) has gone, so the typing is not wasted behind it.
    if (!document.getElementById("splash")) play();
    else {
        const watch = new MutationObserver(() => {
            if (document.getElementById("splash")) return;
            watch.disconnect();
            play();
        });
        watch.observe(document.body, { childList: true });
    }
}

// Scroll to the content smoothly instead of jumping.
hero?.querySelector(".hero-down")?.addEventListener("click", (e) => {
    e.preventDefault();
    document.getElementById("main-grid")?.scrollIntoView({ behavior: "smooth" });
});
</script>
