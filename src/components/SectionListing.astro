---
// One section's full list (Blog, Notes or Projects), reached from the navbar.
import Pagination from "@components/control/Pagination.astro";
import PostPage from "@components/PostPage.astro";
import {
	EMPTY_SECTION_TEXT,
	SECTIONS,
	type SectionType,
} from "@constants/sections";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import type { Page } from "astro";

interface Props {
	type: SectionType;
	page: Page;
	// Notes show how finished each one is; the other sections do not.
	showStatus?: boolean;
}

const { type, page, showStatus = false } = Astro.props;
const section = SECTIONS[type];
const len = page.data.length;
---
<MainGridLayout title={section.name} description={section.description}>
    <div class="card-base px-6 md:px-9 py-6 mb-4 onload-animation">
        <h1 class="relative font-bold text-3xl text-90
            before:hidden md:before:block before:w-1 before:h-5 before:rounded-md before:bg-[var(--primary)]
            before:absolute before:left-[-1.125rem] before:top-[0.6rem]">{section.name}</h1>
        <div class="text-75 mt-2">{section.description}</div>
        {page.total > 0
            ? <div class="text-sm text-50 mt-3">共 {page.total} 篇</div>
            : <div class="text-50 mt-4">{EMPTY_SECTION_TEXT}</div>}
    </div>

    {len > 0 && <PostPage page={page} showStatus={showStatus}></PostPage>}
    {page.lastPage > 1 && <Pagination class="mx-auto onload-animation" page={page} style={`animation-delay: calc(var(--content-delay) + ${len * 50}ms)`}></Pagination>}
</MainGridLayout>
