---
import { profileConfig } from "../config";
import ImageWrapper from "./misc/ImageWrapper.astro";
---
<!-- Skip the splash before it paints if this browser entered the blog in the last day -->
<script is:inline>
    try {
        if (Date.now() - Number(localStorage.getItem("splash-seen")) < 86400000) document.documentElement.classList.add("splash-seen");
    } catch {}
</script>

<div id="splash" role="dialog" aria-label="进入博客">
    <canvas id="splash-sky"></canvas>
    <div id="splash-ring"></div>
    <button type="button" id="splash-avatar" aria-label="点击头像进入博客">
        <ImageWrapper src={profileConfig.avatar || ""} alt="" class="w-full h-full" />
    </button>
    <div id="splash-tip">点击头像</div>
</div>

<style is:global>
    .splash-seen #splash { display: none; }
    #splash {
        position: fixed;
        inset: 0;
        z-index: 9999;
        background: #03040a;
        overflow: hidden;
    }
    #splash-sky {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        opacity: 0;
        transition: opacity 1.2s ease, filter 1.6s ease;
    }
    #splash-sky.ready { opacity: 1; }
    #splash-avatar, #splash-ring {
        position: absolute;
        left: 50%;
        top: 44%;
        width: 7rem;
        height: 7rem;
        margin: -3.5rem 0 0 -3.5rem;
        border-radius: 50%;
    }
    #splash-avatar {
        padding: 0;
        overflow: hidden;
        cursor: pointer;
        border: 2px solid rgba(200, 215, 255, 0.55);
        background: #1b2340;
        transition: transform 0.35s cubic-bezier(0.3, 0, 0.2, 1), opacity 0.9s ease, box-shadow 0.5s, filter 0.9s;
    }
    #splash-avatar:hover, #splash-avatar:focus-visible {
        outline: none;
        box-shadow: 0 0 0 10px rgba(150, 170, 255, 0.12), 0 0 0 22px rgba(150, 170, 255, 0.06);
    }
    #splash-ring {
        border: 1px solid rgba(200, 215, 255, 0.7);
        opacity: 0;
        pointer-events: none;
    }
    #splash-tip {
        position: absolute;
        left: 0;
        right: 0;
        top: calc(44% + 5rem);
        text-align: center;
        color: rgba(220, 228, 255, 0.6);
        font-size: 0.8125rem;
        letter-spacing: 0.3em;
        transition: opacity 0.5s;
        pointer-events: none;
    }
</style>

<script>
// Procedural deep-space sky behind the avatar. The heavy layers are drawn once;
// each frame only moves them (rotation and mouse parallax) and redraws the twinkling stars.
const SEED = 20261022;
// Tuned by eye: how bright the highlights get, and how much the sky darkens around the avatar.
const HIGHLIGHT = 0.45;
const VIGNETTE = 0.6;
// Centre of the single nebula mass, in sky-layer coordinates (0..1).
const NEBULA_X = 0.5 + Math.cos(-0.6) * 0.3;
const NEBULA_Y = 0.5 + Math.sin(-0.6) * 0.3;

const splash = document.getElementById("splash");
const seen = document.documentElement.classList.contains("splash-seen");
if (splash && seen) splash.remove();
else if (splash) startSplash(splash);

function startSplash(splash: HTMLElement) {
    const cv = document.getElementById("splash-sky") as HTMLCanvasElement;
    const ctx = cv.getContext("2d")!;
    const av = document.getElementById("splash-avatar")!;
    const ring = document.getElementById("splash-ring")!;
    const tip = document.getElementById("splash-tip")!;
    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const small = Math.min(innerWidth, innerHeight) < 700;
    const dpr = Math.min(2, devicePixelRatio || 1);

    let seed = SEED;
    const rnd = () => {
        seed = (seed * 16807) % 2147483647;
        return (seed - 1) / 2147483646;
    };
    const P = new Uint8Array(512);
    const initNoise = () => {
        const p = [...Array(256).keys()];
        for (let i = 255; i > 0; i--) {
            const j = Math.floor(rnd() * (i + 1));
            [p[i], p[j]] = [p[j], p[i]];
        }
        for (let i = 0; i < 512; i++) P[i] = p[i & 255];
    };
    const sm = (t: number) => t * t * (3 - 2 * t);
    const vn = (x: number, y: number) => {
        const X = Math.floor(x), Y = Math.floor(y), fx = sm(x - X), fy = sm(y - Y);
        const h = (i: number, j: number) => P[(P[(X + i) & 255] + Y + j) & 511] / 255;
        return h(0, 0) * (1 - fx) * (1 - fy) + h(1, 0) * fx * (1 - fy) + h(0, 1) * (1 - fx) * fy + h(1, 1) * fx * fy;
    };
    const fbm = (x: number, y: number, o = 5) => {
        let v = 0, a = 0.5, f = 1, n = 0;
        for (let i = 0; i < o; i++) {
            v += a * vn(x * f, y * f);
            n += a;
            f *= 2.07;
            a *= 0.5;
        }
        return v / n;
    };
    const ss = (e0: number, e1: number, x: number) => {
        const t = Math.max(0, Math.min(1, (x - e0) / (e1 - e0)));
        return t * t * (3 - 2 * t);
    };
    const mix = (a: number, b: number, t: number) => a + (b - a) * t;
    const gauss = () => (rnd() + rnd() + rnd() + rnd() - 2) / 2;

    // Star colours by temperature, from hot blue to cool red.
    const TEMP = ["155,176,255", "190,205,255", "230,235,255", "255,246,236", "255,226,190", "255,196,140", "255,160,110"];
    const starCol = () => {
        const r = rnd();
        return TEMP[r < 0.12 ? 0 : r < 0.3 ? 1 : r < 0.55 ? 2 : r < 0.72 ? 3 : r < 0.86 ? 4 : r < 0.95 ? 5 : 6];
    };

    type Star = { x: number; y: number; r: number; big: boolean; c: string; ph: number; sp: number; a: number; spk: number };
    let W = 0, H = 0, S = 0;
    let far: HTMLCanvasElement, mid: HTMLCanvasElement, live: Star[] = [];
    let mx = 0, my = 0, sx = 0, sy = 0, running = true, meteor: { x: number; y: number; l: number } | null = null;

    const layer = (): [HTMLCanvasElement, CanvasRenderingContext2D] => {
        const c = document.createElement("canvas");
        c.width = S;
        c.height = S;
        return [c, c.getContext("2d")!];
    };
    const glow = (g: CanvasRenderingContext2D, x: number, y: number, r: number, c: string, a: number) => {
        if (a <= 0) return;
        const gr = g.createRadialGradient(x, y, 0, x, y, r);
        gr.addColorStop(0, `rgba(${c},${a})`);
        gr.addColorStop(0.35, `rgba(${c},${a * 0.35})`);
        gr.addColorStop(1, `rgba(${c},0)`);
        g.fillStyle = gr;
        g.beginPath();
        g.arc(x, y, r, 0, 6.28);
        g.fill();
    };
    const galaxy = (g: CanvasRenderingContext2D, x: number, y: number, size: number) => {
        const spiral = rnd() < 0.6, h = mix(0.45, 1, HIGHLIGHT);
        g.save();
        g.translate(x, y);
        g.rotate(rnd() * 6.28);
        g.scale(1, 0.25 + rnd() * 0.75);
        if (!spiral) {
            glow(g, 0, 0, size, "255,225,190", 0.4 * h);
            glow(g, 0, 0, size * 0.35, "255,240,220", 0.45 * h);
        } else {
            glow(g, 0, 0, size * 0.9, "170,180,255", 0.14 * h);
            glow(g, 0, 0, size * 0.28, "255,235,200", 0.55 * h);
            const twist = rnd() * 6.28;
            for (let arm = 0; arm < 2; arm++)
                for (let t = 0; t < 3.2; t += 0.035) {
                    const r = size * 0.12 * Math.exp(0.55 * t), th = t * 1.9 + arm * Math.PI + twist;
                    g.fillStyle = `rgba(${rnd() < 0.3 ? "255,170,210" : "175,195,255"},${0.3 * h * (1 - t / 3.4)})`;
                    g.fillRect(Math.cos(th) * r + gauss() * size * 0.06, Math.sin(th) * r + gauss() * size * 0.06, 1.1, 1.1);
                }
        }
        g.restore();
    };

    function build() {
        seed = SEED;
        W = innerWidth;
        H = innerHeight;
        S = Math.ceil(Math.hypot(W, H)) + 80;
        cv.width = W * dpr;
        cv.height = H * dpr;
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

        // Elements thin out around the avatar and gather towards the edges of the screen.
        const m = Math.min(W, H);
        const edge = (x: number, y: number) => ss(0.12 * m, 0.45 * m, Math.hypot(x - S / 2, y - S / 2));

        initNoise();
        const N = small ? 200 : 300, img = new ImageData(N, N), dens = new Float32Array(N * N);
        rnd();
        const gain = mix(1.5, 3.2, HIGHLIGHT), top = mix(0.62, 1, HIGHLIGHT);
        for (let j = 0; j < N; j++)
            for (let i = 0; i < N; i++) {
                const u = (i + 0.5) / N, v = (j + 0.5) / N;
                const qx = fbm(u * 2.5, v * 2.5, 4), qy = fbm(u * 2.5 + 5.2, v * 2.5 + 1.3, 4);
                const cloud = fbm(u * 4 + 2.2 * qx, v * 4 + 2.2 * qy, 5);
                let d = ss(0.42, 0.8, cloud) * 0.85 + 0.04;
                const core = ss(0.55, 0.85, fbm(u * 1.5 + 7, v * 1.5 + 2, 3)) * mix(0.3, 0.6, HIGHLIGHT);
                const lane = ss(0.5, 0.72, fbm(u * 5 + qx * 3 + 3, v * 5 + qy * 3 + 8, 5)) * 0.75;
                d *= 1 - 0.82 * lane;
                // One nebula mass towards the upper right with a ragged outline; elsewhere only faint wisps.
                const blob = ss(0, 0.55, 1 - Math.hypot(u - NEBULA_X, v - NEBULA_Y) / 0.32 + (fbm(u * 3 + 91, v * 3 + 7, 4) - 0.5) * 0.9);
                d *= (blob * 0.95 + 0.06) * edge(u * S, v * S);
                const pink = ss(0.6, 0.75, fbm(u * 5 + 31, v * 5 + 17, 4)) * 0.8;
                const teal = ss(0.55, 0.75, fbm(u * 3 + 51, v * 3 + 5, 4)) * 0.6;
                let r = mix(70, 255, core), g = mix(80, 205, core), b = mix(170, 150, core);
                r = mix(r, 230, pink * 0.7); g = mix(g, 90, pink * 0.7); b = mix(b, 150, pink * 0.7);
                r = mix(r, 60, teal); g = mix(g, 170, teal); b = mix(b, 200, teal);
                const rf = 1 - Math.abs(2 * fbm(u * 7 + qx * 2.5 + 13, v * 7 + qy * 2.5 + 29, 5) - 1);
                const fl = Math.pow(rf, 7) * Math.sqrt(Math.max(0, d)) * (1 - lane * 0.6) * mix(0.9, 1.6, HIGHLIGHT);
                const fc = fbm(u * 3 + 71, v * 3 + 3, 3);
                r += fl * mix(120, 255, fc); g += fl * mix(230, 140, fc); b += fl * mix(255, 200, fc);
                d += fl * 0.2;
                // Soft tone curve so the brightest cloud never glares.
                const k = (1 - Math.exp(-Math.max(0, d) * gain)) * top, p = (j * N + i) * 4;
                img.data[p] = 4 + Math.min(255, r) * k;
                img.data[p + 1] = 5 + Math.min(255, g) * k;
                img.data[p + 2] = 12 + Math.min(255, b) * k;
                img.data[p + 3] = 255;
                dens[j * N + i] = Math.max(0, d);
            }
        const lo = document.createElement("canvas");
        lo.width = N;
        lo.height = N;
        lo.getContext("2d")!.putImageData(img, 0, 0);
        const at = (x: number, y: number) => dens[Math.min(N - 1, Math.floor((y / S) * N)) * N + Math.min(N - 1, Math.floor((x / S) * N))];

        let g: CanvasRenderingContext2D;
        [far, g] = layer();
        g.imageSmoothingQuality = "high";
        g.filter = "blur(1.5px)";
        g.drawImage(lo, -4, -4, S + 8, S + 8);
        g.filter = "none";
        g.globalCompositeOperation = "lighter";
        const dust = small ? 45000 : 90000;
        for (let n = 0; n < dust; n++) {
            const x = rnd() * S, y = rnd() * S, d = at(x, y);
            if (rnd() > (0.04 + d * 1.2) * (0.3 + 0.7 * edge(x, y))) continue;
            g.fillStyle = `rgba(${starCol()},${0.06 + rnd() * 0.2 * Math.min(1, d + 0.2)})`;
            g.fillRect(x, y, 0.7, 0.7);
        }
        // Soft glowing pockets inside the nebula.
        for (let made = 0, tries = 0; made < 4 && tries < 4000; tries++) {
            const x = rnd() * S, y = rnd() * S;
            if (at(x, y) < 0.3) continue;
            made++;
            const c = ["255,120,170", "120,220,230", "255,200,140", "200,140,255"][Math.floor(rnd() * 4)], R = 40 + rnd() * 70;
            glow(g, x, y, R * 1.2, c, mix(0.1, 0.22, HIGHLIGHT));
            glow(g, x, y, R * 0.3, c, mix(0.06, 0.35, HIGHLIGHT));
            glow(g, x, y, R * 0.08, "255,250,245", mix(0, 0.8, HIGHLIGHT * HIGHLIGHT));
            for (let s = 0; s < 25; s++) {
                const a = rnd() * 6.28, rr = Math.abs(gauss()) * R * 0.35;
                g.fillStyle = `rgba(235,240,255,${mix(0.35, 0.8, HIGHLIGHT)})`;
                g.fillRect(x + Math.cos(a) * rr, y + Math.sin(a) * rr, 1, 1);
            }
        }
        for (let n = 0; n < 14; n++) {
            const x = rnd() * S, y = rnd() * S;
            if (rnd() > edge(x, y) || (at(x, y) > 0.35 && rnd() < 0.7)) continue;
            galaxy(g, x, y, 5 + Math.pow(rnd(), 2) * 26);
        }
        g.globalCompositeOperation = "source-over";

        [mid, g] = layer();
        g.globalCompositeOperation = "lighter";
        const stars = small ? 7000 : 14000;
        for (let n = 0; n < stars; n++) {
            const x = rnd() * S, y = rnd() * S, d = at(x, y);
            if (rnd() > (0.18 + d * 0.9) * (0.35 + 0.65 * edge(x, y))) continue;
            g.fillStyle = `rgba(${starCol()},${0.3 + rnd() * 0.45})`;
            g.beginPath();
            g.arc(x, y, 0.45 + rnd() * 0.65, 0, 6.28);
            g.fill();
        }
        // Open clusters of young blue stars, then two dense globular clusters.
        for (let n = 0, tries = 0; n < 4 && tries < 200; tries++) {
            const x = rnd() * S, y = rnd() * S, R = 18 + rnd() * 28;
            if (edge(x, y) < 0.8) continue;
            n++;
            glow(g, x, y, R * 2.2, "120,150,255", mix(0.03, 0.08, HIGHLIGHT));
            for (let s = 0; s < 45; s++) {
                const rr = Math.abs(gauss()) * R, a = rnd() * 6.28;
                g.fillStyle = `rgba(${TEMP[rnd() < 0.6 ? 0 : 1]},${mix(0.4, 0.6, HIGHLIGHT) + rnd() * 0.35})`;
                g.beginPath();
                g.arc(x + Math.cos(a) * rr, y + Math.sin(a) * rr, 0.5 + rnd() * mix(0.6, 1.1, HIGHLIGHT), 0, 6.28);
                g.fill();
            }
        }
        for (let n = 0, tries = 0; n < 2 && tries < 200; tries++) {
            const x = rnd() * S, y = rnd() * S, R = 10 + rnd() * 8;
            if (edge(x, y) < 0.8) continue;
            n++;
            glow(g, x, y, R * 1.6, "255,225,170", mix(0.07, 0.25, HIGHLIGHT));
            for (let s = 0; s < 700; s++) {
                const rr = Math.abs(gauss()) * R * 1.2, a = rnd() * 6.28;
                g.fillStyle = `rgba(255,${(220 + rnd() * 30) | 0},${(170 + rnd() * 60) | 0},${mix(0.12, 0.25, HIGHLIGHT) + rnd() * mix(0.25, 0.5, HIGHLIGHT)})`;
                g.fillRect(x + Math.cos(a) * rr, y + Math.sin(a) * rr, 0.8, 0.8);
            }
        }
        g.globalCompositeOperation = "source-over";

        live = [];
        const liveCount = small ? 200 : 380;
        while (live.length < liveCount) {
            const x = rnd() * S, y = rnd() * S;
            if (rnd() > (0.35 + at(x, y)) * (0.25 + 0.75 * edge(x, y))) continue;
            const big = rnd() < 0.08;
            live.push({
                x, y, big,
                r: big ? mix(1, 1.3, HIGHLIGHT) + rnd() * mix(0.6, 1.1, HIGHLIGHT) : 0.6 + rnd() * 0.6,
                c: starCol(),
                ph: rnd() * 6.28,
                sp: 0.6 + rnd() * 2.2,
                a: 0.45 + rnd() * 0.45,
                spk: 0,
            });
        }
        // A few of the outer stars get faint diffraction spikes.
        const spikes = live.filter((s) => edge(s.x, s.y) > 0.9).slice(0, Math.round(mix(5, 11, HIGHLIGHT)));
        for (const s of spikes) {
            s.spk = mix(8, 14, HIGHLIGHT) + Math.pow(rnd(), 1.5) * mix(14, 48, HIGHLIGHT);
            s.r = mix(1.2, 1.6, HIGHLIGHT) + rnd() * mix(0.5, 1.2, HIGHLIGHT);
            s.a = mix(0.7, 1, HIGHLIGHT);
        }
    }

    function spike(x: number, y: number, L: number, c: string, a: number) {
        const gr = ctx.createRadialGradient(x, y, 0, x, y, L * 0.35);
        gr.addColorStop(0, `rgba(${c},${0.45 * a})`);
        gr.addColorStop(1, `rgba(${c},0)`);
        ctx.fillStyle = gr;
        ctx.beginPath();
        ctx.arc(x, y, L * 0.35, 0, 6.28);
        ctx.fill();
        ctx.lineWidth = 0.8;
        for (let k = 0; k < 4; k++) {
            const an = (k * Math.PI) / 2 + 0.35, ex = x + Math.cos(an) * L, ey = y + Math.sin(an) * L;
            const lg = ctx.createLinearGradient(x, y, ex, ey);
            lg.addColorStop(0, `rgba(${c},${0.75 * a})`);
            lg.addColorStop(1, `rgba(${c},0)`);
            ctx.strokeStyle = lg;
            ctx.beginPath();
            ctx.moveTo(x, y);
            ctx.lineTo(ex, ey);
            ctx.stroke();
        }
    }

    function draw(now: number) {
        const t = reduced ? 0 : now / 1000;
        sx += (mx - sx) * 0.05;
        sy += (my - sy) * 0.05;
        ctx.fillStyle = "#03040a";
        ctx.fillRect(0, 0, W, H);
        ctx.save();
        ctx.translate(W / 2, H / 2);
        ctx.rotate(t * 0.003);
        ctx.drawImage(far, -S / 2 - sx * 6, -S / 2 - sy * 6, S, S);
        ctx.drawImage(mid, -S / 2 - sx * 16, -S / 2 - sy * 16, S, S);
        const sa = mix(0.6, 1, HIGHLIGHT);
        for (const s of live) {
            const tw = s.spk ? 0.85 + 0.15 * Math.sin(t * s.sp + s.ph) : 0.6 + 0.4 * Math.sin(t * s.sp + s.ph);
            const x = s.x - S / 2 - sx * 30, y = s.y - S / 2 - sy * 30;
            if (s.spk) spike(x, y, s.spk * (0.9 + 0.1 * tw), s.c, tw * sa);
            ctx.fillStyle = `rgba(${s.c},${s.a * tw})`;
            ctx.beginPath();
            ctx.arc(x, y, s.r, 0, 6.28);
            ctx.fill();
            if (s.big && !s.spk) {
                ctx.fillStyle = `rgba(${s.c},${0.08 * tw * sa})`;
                ctx.beginPath();
                ctx.arc(x, y, s.r * 3.5, 0, 6.28);
                ctx.fill();
            }
        }
        ctx.restore();
        // Darken softly around the avatar so it stays the focal point.
        const cx = W / 2, cy = H * 0.44, R = Math.min(W, H) * 0.55, vg = ctx.createRadialGradient(cx, cy, 0, cx, cy, R);
        vg.addColorStop(0, `rgba(3,4,10,${0.75 * VIGNETTE})`);
        vg.addColorStop(0.45, `rgba(3,4,10,${0.4 * VIGNETTE})`);
        vg.addColorStop(1, "rgba(3,4,10,0)");
        ctx.fillStyle = vg;
        ctx.fillRect(0, 0, W, H);
        if (!reduced) {
            if (!meteor && Math.random() < 0.003) meteor = { x: Math.random() * W * 0.8 + W * 0.2, y: Math.random() * H * 0.35, l: 0 };
            if (meteor) {
                meteor.l += 0.022;
                const L = meteor.l, x = meteor.x - L * 280, y = meteor.y + L * 130;
                ctx.strokeStyle = `rgba(225,232,255,${Math.max(0, 0.6 - L * 0.6)})`;
                ctx.lineWidth = 1;
                ctx.beginPath();
                ctx.moveTo(x, y);
                ctx.lineTo(x + 70, y - 32);
                ctx.stroke();
                if (L > 1) meteor = null;
            }
        }
    }

    function loop(now: number) {
        if (!running) return;
        draw(now);
        if (!reduced) requestAnimationFrame(loop);
    }

    // Let the black screen and avatar paint first, then build the sky and fade it in.
    setTimeout(() => {
        build();
        cv.classList.add("ready");
        requestAnimationFrame(loop);
    }, 30);

    let resizeTimer = 0;
    addEventListener("resize", () => {
        if (!running) return;
        clearTimeout(resizeTimer);
        resizeTimer = window.setTimeout(() => {
            build();
            if (reduced) draw(0);
        }, 200);
    });
    if (!reduced) {
        splash.addEventListener("mousemove", (e) => {
            mx = e.clientX / W - 0.5;
            my = e.clientY / H - 0.5;
        });
        splash.addEventListener("mouseleave", () => {
            mx = 0;
            my = 0;
        });
    }
    // Keep the page underneath from scrolling while the splash is up.
    const block = (e: Event) => e.preventDefault();
    splash.addEventListener("wheel", block, { passive: false });
    splash.addEventListener("touchmove", block, { passive: false });

    const ease = (k: number) => (k < 0.5 ? 4 * k * k * k : 1 - Math.pow(-2 * k + 2, 3) / 2);
    const page = () => Array.from(document.body.children).filter((el) => el !== splash && el.tagName !== "SCRIPT") as HTMLElement[];

    function finish() {
        running = false;
        for (const el of page()) el.style.filter = "";
        splash.remove();
    }

    let entering = false;
    function enter() {
        if (entering) return;
        entering = true;
        try {
            localStorage.setItem("splash-seen", String(Date.now()));
        } catch {}
        tip.style.opacity = "0";

        if (reduced) {
            splash.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 500, easing: "ease" }).onfinish = finish;
            return;
        }

        // Beat 1: the avatar is pressed in and a ripple leaves it.
        av.style.transform = "scale(0.9)";
        ring.animate([{ transform: "scale(1)", opacity: 0.8 }, { transform: "scale(2.4)", opacity: 0 }], {
            duration: 900,
            easing: "cubic-bezier(.2,.6,.3,1)",
        });
        setTimeout(() => {
            av.style.transform = "scale(1.04)";
        }, 350);

        // Beat 2 and 3: the sky loses focus, then the blog opens from the avatar with a soft edge.
        setTimeout(() => {
            cv.style.filter = "blur(6px) brightness(.7)";
            av.style.opacity = "0";
            av.style.filter = "blur(4px)";
            const r = av.getBoundingClientRect();
            const x = r.left + r.width / 2, y = r.top + r.height / 2, R = Math.hypot(W, H), start = performance.now(), dur = 1700;
            const els = page();
            const step = (n: number) => {
                const k = Math.min(1, (n - start) / dur), e = ease(k), rad = 40 + e * R, f = 60 + e * 140;
                const m = `radial-gradient(circle at ${x}px ${y}px, transparent ${Math.max(0, rad - f)}px, #000 ${rad}px)`;
                splash.style.webkitMaskImage = m;
                splash.style.maskImage = m;
                for (const el of els) el.style.filter = `blur(${(1 - e) * 10}px)`;
                if (k < 1) requestAnimationFrame(step);
                else finish();
            };
            requestAnimationFrame(step);
        }, 650);
    }

    av.addEventListener("click", enter);
    document.addEventListener("keydown", (e) => {
        if (document.getElementById("splash") && (e.key === "Escape" || e.key === "Enter")) enter();
    });
}
</script>
