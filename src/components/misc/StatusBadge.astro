---
// How finished a post is, set with `status:` in the post frontmatter.
export type PostStatus = "done" | "partial" | "wip";

interface Props {
	status: PostStatus;
	class?: string;
}

const LABELS: Record<PostStatus, string> = {
	done: "已完成",
	partial: "待补充",
	wip: "施工中",
};

const { status } = Astro.props;
---
<span class:list={["status-badge", `status-${status}`, Astro.props.class]}>{LABELS[status]}</span>

<style>
    .status-badge {
        display: inline-flex;
        align-items: center;
        flex-shrink: 0;
        height: 1.75rem;
        padding: 0 0.625rem;
        border-radius: 0.5rem;
        border: 1px solid var(--badge-border);
        background: var(--badge-bg);
        color: var(--badge-text);
        font-size: 0.875rem;
        font-weight: 500;
        line-height: 1;
        white-space: nowrap;
    }
    .status-done { --badge-text: #15803d; --badge-bg: rgb(34 197 94 / 0.1); --badge-border: rgb(34 197 94 / 0.3); }
    .status-partial { --badge-text: #0369a1; --badge-bg: rgb(14 165 233 / 0.1); --badge-border: rgb(14 165 233 / 0.3); }
    .status-wip { --badge-text: #b45309; --badge-bg: rgb(245 158 11 / 0.12); --badge-border: rgb(245 158 11 / 0.35); }
    :global(.dark) .status-done { --badge-text: #4ade80; --badge-bg: rgb(34 197 94 / 0.1); }
    :global(.dark) .status-partial { --badge-text: #38bdf8; --badge-bg: rgb(14 165 233 / 0.1); }
    :global(.dark) .status-wip { --badge-text: #fbbf24; --badge-bg: rgb(245 158 11 / 0.1); }
</style>
