---
// Claude Code token usage, from src/data/token-usage.json (refresh with `pnpm usage`).
import usage from "../../data/token-usage.json";

type Day = {
	input: number;
	output: number;
	cacheWrite: number;
	cacheRead: number;
};

const WEEKS = 53;
const DAY_MS = 86400000;
const days: Record<string, Day> = usage.days;
const totalOf = (d: Day) => d.input + d.output + d.cacheWrite + d.cacheRead;

// Dates are handled as UTC midnights of the local calendar day, so no time zone shifts creep in.
const keyOf = (t: number) => new Date(t).toISOString().slice(0, 10);
const end = Date.parse(`${usage.updated}T00:00:00Z`);
const endWeekday = (new Date(end).getUTCDay() + 6) % 7; // Monday = 0
const start = end - (endWeekday + (WEEKS - 1) * 7) * DAY_MS;

// Shade by quartiles of the active days, so one huge day does not wash out the rest.
const active = Object.values(days)
	.map(totalOf)
	.filter((n) => n > 0)
	.sort((a, b) => a - b);
const cut = (q: number) => active[Math.floor((active.length - 1) * q)] ?? 0;
const cuts = [cut(0.25), cut(0.5), cut(0.75)];
const levelOf = (n: number) =>
	n <= 0 ? 0 : 1 + cuts.filter((c) => n > c).length;

function fmt(n: number) {
	if (n >= 1e8) return `${(n / 1e8).toFixed(2)} 亿`;
	if (n >= 1e4) return `${(n / 1e4).toFixed(1)} 万`;
	return n.toLocaleString("en-US");
}

const weeks = Array.from({ length: WEEKS }, (_, w) => {
	const cells = Array.from({ length: 7 }, (_, d) => {
		const t = start + (w * 7 + d) * DAY_MS;
		if (t > end) return null;
		const key = keyOf(t);
		const total = days[key] ? totalOf(days[key]) : 0;
		return { key, total, level: levelOf(total) };
	});
	const first = new Date(start + w * 7 * DAY_MS);
	const monthStart = cells.find((c) => c?.key.endsWith("-01"));
	const label =
		w === 0
			? `${first.getUTCMonth() + 1}月`
			: monthStart
				? `${Number(monthStart.key.slice(5, 7))}月`
				: "";
	return { cells, label };
});

const sum = Object.values(days).reduce(
	(acc, d) => ({
		input: acc.input + d.input,
		output: acc.output + d.output,
		cacheWrite: acc.cacheWrite + d.cacheWrite,
		cacheRead: acc.cacheRead + d.cacheRead,
	}),
	{ input: 0, output: 0, cacheWrite: 0, cacheRead: 0 },
);
const grand = totalOf(sum);
const peak = Object.entries(days).reduce<[string, number]>(
	(best, [k, d]) => (totalOf(d) > best[1] ? [k, totalOf(d)] : best),
	["", 0],
);
const rows = [
	["输入", sum.input],
	["输出", sum.output],
	["缓存写入", sum.cacheWrite],
	["缓存读取", sum.cacheRead],
] as const;
---
<section class="token-usage">
    <div class="flex flex-wrap items-end justify-between gap-2 mb-4">
        <div>
            <div class="text-sm text-50">Claude Code 总用量</div>
            <div class="text-3xl font-bold text-90">{fmt(grand)} <span class="text-base font-normal text-50">tokens</span></div>
        </div>
        <div class="text-sm text-50">
            活跃 {active.length} 天{peak[0] && ` · 单日最高 ${fmt(peak[1])}（${peak[0]}）`}
        </div>
    </div>

    <div class="heatmap-scroll">
        <div class="heatmap">
            <div class="months" style={`grid-template-columns: repeat(${WEEKS}, var(--cell))`}>
                {weeks.map((w) => <span>{w.label}</span>)}
            </div>
            <div class="body">
                <div class="weekdays"><span>一</span><span></span><span>三</span><span></span><span>五</span><span></span><span></span></div>
                <div class="grid" style={`grid-template-columns: repeat(${WEEKS}, var(--cell))`}>
                    {weeks.map((w) => (
                        <div class="week">
                            {w.cells.map((c) =>
                                c ? (
                                    <span
                                        class={`cell l${c.level}`}
                                        title={`${c.key} · ${c.total ? `${fmt(c.total)} tokens` : "无记录"}`}
                                    ></span>
                                ) : (
                                    <span class="cell empty"></span>
                                ),
                            )}
                        </div>
                    ))}
                </div>
            </div>
        </div>
    </div>
    <div class="flex items-center justify-end gap-1 mt-2 text-xs text-50">
        少<span class="cell l0"></span><span class="cell l1"></span><span class="cell l2"></span><span class="cell l3"></span><span class="cell l4"></span>多
    </div>

    <table class="w-full mt-4 text-sm">
        <tbody>
            {rows.map(([name, n]) => (
                <tr class="border-b border-dashed border-[var(--line-divider)]">
                    <td class="py-2 text-75">{name}</td>
                    <td class="py-2 text-right font-mono text-90">{n.toLocaleString("en-US")}</td>
                    <td class="py-2 pl-3 text-right text-50 w-16">{grand ? ((n / grand) * 100).toFixed(1) : 0}%</td>
                </tr>
            ))}
        </tbody>
    </table>
    <p class="mt-3 text-xs text-50">
        缓存读取是每轮对话重复带上的上下文，按很低的价格计费，所以数量会远大于输入和输出。数据来自本机 Claude Code 记录，更新于 {usage.updated}。
    </p>
</section>

<style>
    .token-usage { --cell: 11px; --gap: 3px; }
    /* rtl makes the scroll start at the right end, so the latest weeks show first on narrow screens */
    .heatmap-scroll { overflow-x: auto; direction: rtl; padding-bottom: 4px; }
    .heatmap { direction: ltr; width: max-content; }
    .months { display: grid; column-gap: var(--gap); margin-left: calc(1.25rem + var(--gap)); height: 1rem; font-size: 10px; color: var(--text-50, rgba(128, 128, 128, 0.8)); }
    .months span { white-space: nowrap; overflow: visible; width: var(--cell); }
    .body { display: flex; gap: var(--gap); }
    .weekdays { display: grid; grid-template-rows: repeat(7, var(--cell)); row-gap: var(--gap); width: 1.25rem; font-size: 10px; line-height: var(--cell); opacity: 0.5; }
    .grid { display: grid; column-gap: var(--gap); }
    .week { display: grid; grid-template-rows: repeat(7, var(--cell)); row-gap: var(--gap); }
    .cell { display: inline-block; width: var(--cell); height: var(--cell); border-radius: 2px; }
    .cell.empty { background: transparent; }
    .cell.l0 { background: rgb(128 128 128 / 0.12); }
    .cell.l1 { background: color-mix(in oklch, var(--primary) 30%, transparent); }
    .cell.l2 { background: color-mix(in oklch, var(--primary) 55%, transparent); }
    .cell.l3 { background: color-mix(in oklch, var(--primary) 80%, transparent); }
    .cell.l4 { background: var(--primary); }
</style>
