---
// Claude Code token usage, from src/data/token-usage.json (refresh with `pnpm usage`).
import usage from "../../data/token-usage.json";
import WidgetLayout from "./WidgetLayout.astro";

interface Props {
	class?: string;
	style?: string;
}

type Day = {
	input: number;
	output: number;
	cacheWrite: number;
	cacheRead: number;
};

const WEEKS = 16;
const DAY_MS = 86400000;
const days: Record<string, Day> = usage.days;
const totalOf = (d: Day) => d.input + d.output + d.cacheWrite + d.cacheRead;

// Dates are handled as UTC midnights of the local calendar day, so no time zone shifts creep in.
const keyOf = (t: number) => new Date(t).toISOString().slice(0, 10);
const end = Date.parse(`${usage.updated}T00:00:00Z`);
const endWeekday = (new Date(end).getUTCDay() + 6) % 7; // Monday = 0
const start = end - (endWeekday + (WEEKS - 1) * 7) * DAY_MS;

// Shade by quartiles of the active days, so one huge day does not wash out the rest.
const active = Object.values(days)
	.map(totalOf)
	.filter((n) => n > 0)
	.sort((a, b) => a - b);
const cut = (q: number) => active[Math.floor((active.length - 1) * q)] ?? 0;
const cuts = [cut(0.25), cut(0.5), cut(0.75)];
const levelOf = (n: number) =>
	n <= 0 ? 0 : 1 + cuts.filter((c) => n > c).length;

function fmt(n: number) {
	if (n >= 1e8) return `${(n / 1e8).toFixed(2)} 亿`;
	if (n >= 1e4) return `${(n / 1e4).toFixed(1)} 万`;
	return n.toLocaleString("en-US");
}

// Column-major: each week is a column, Monday on top.
const cells = Array.from({ length: WEEKS * 7 }, (_, i) => {
	const t = start + i * DAY_MS;
	if (t > end) return null;
	const key = keyOf(t);
	const total = days[key] ? totalOf(days[key]) : 0;
	return { key, total, level: levelOf(total) };
});

const grand = Object.values(days).reduce((n, d) => n + totalOf(d), 0);
const io = Object.values(days).reduce((n, d) => n + d.input + d.output, 0);
const month = (t: number) => `${new Date(t).getUTCMonth() + 1}月`;
---
<WidgetLayout name="Token 用量" id="token-usage" class={Astro.props.class} style={Astro.props.style}>
    <div class="flex items-baseline gap-1.5 px-1">
        <span class="text-2xl font-bold text-90">{fmt(grand)}</span>
        <span class="text-sm text-50">tokens</span>
    </div>
    <div class="text-xs text-50 px-1 mb-3">
        活跃 {active.length} 天 · 输入加输出 {fmt(io)}
    </div>

    <div class="token-grid" style={`grid-template-columns: repeat(${WEEKS}, minmax(0, 14px))`}>
        {cells.map((c) =>
            c ? (
                <span
                    class={`cell l${c.level}`}
                    title={`${c.key} · ${c.total ? `${fmt(c.total)} tokens` : "无记录"}`}
                ></span>
            ) : (
                <span></span>
            ),
        )}
    </div>

    <div class="token-foot flex justify-between items-center mt-2 px-1 text-xs text-50">
        <span>{month(start)}</span>
        <span class="flex items-center gap-[3px]">
            少<span class="cell l0 legend"></span><span class="cell l2 legend"></span><span class="cell l4 legend"></span>多
        </span>
        <span>{month(end)}</span>
    </div>
    <div class="text-[0.7rem] text-30 mt-1 px-1">Claude Code 本机记录 · 更新于 {usage.updated}</div>
</WidgetLayout>

<style>
    .token-grid {
        display: grid;
        grid-template-rows: repeat(7, auto);
        grid-auto-flow: column;
        gap: 3px;
    }
    /* keep the month labels lined up with the grid when it stops growing */
    .token-foot { max-width: calc(16 * 14px + 15 * 3px); }
    .cell { display: block; aspect-ratio: 1; border-radius: 2px; }
    .cell.legend { display: inline-block; width: 9px; height: 9px; }
    .cell.l0 { background: rgb(128 128 128 / 0.12); }
    .cell.l1 { background: color-mix(in oklch, var(--primary) 30%, transparent); }
    .cell.l2 { background: color-mix(in oklch, var(--primary) 55%, transparent); }
    .cell.l3 { background: color-mix(in oklch, var(--primary) 80%, transparent); }
    .cell.l4 { background: var(--primary); }
</style>
