---
import { getEntry, render } from "astro:content";
import Markdown from "@components/misc/Markdown.astro";
import MainGridLayout from "../layouts/MainGridLayout.astro";

// Simple navbar sections whose content lives in src/content/spec/<section>.md.
// getStaticPaths runs in its own scope, so the list has to live inside it.
export function getStaticPaths() {
	const sections = {
		notes: "Notes",
		lab: "Lab",
		talks: "Talks",
		projects: "Projects",
		links: "Links",
		contact: "Contact",
	};
	return Object.entries(sections).map(([section, title]) => ({
		params: { section },
		props: { title },
	}));
}

const { section } = Astro.params;
const { title } = Astro.props;
const entry = await getEntry("spec", section);

if (!entry) {
	throw new Error(`Section content not found: src/content/spec/${section}.md`);
}

const { Content } = await render(entry);
---
<MainGridLayout title={title} description={title}>
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
        <div class="card-base z-10 px-9 py-6 relative w-full ">
            <Markdown class="mt-2">
                <Content />
            </Markdown>
        </div>
    </div>
</MainGridLayout>
