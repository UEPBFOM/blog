---
import { identity } from '@/site.identity'

import PageLayout from '@/layouts/CommonPage.astro'

export const prerender = true
---

<PageLayout title='Contact' headings={[]}>
  <h2>Let’s connect</h2><p>For questions about posts or projects, you can reach me here.</p><ul>
    <li>
      <a href={identity.github} target='_blank' rel='noopener noreferrer'>GitHub · UEPBFOM ↗</a>
    </li><li><a href={'mailto:' + identity.email}>{identity.email}</a></li>
  </ul>
</PageLayout>
